<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 壁纸层 -->
    <ImageView
        android:id="@+id/iv_wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <!-- 主内容层 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 顶部状态栏 -->
        <include
            android:id="@+id/status_bar"
            layout="@layout/layout_status_bar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/status_bar_height" />

        <!-- 中间区域：上下布局 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <!-- 上半部分：导航卡片 - SDK导航控件容器 -->
            <FrameLayout
                android:id="@+id/nav_card"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="3"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:background="@drawable/bg_plugin_card"
                android:clipToOutline="true">

                <!-- 导航占位页（未启动时显示） -->
                <LinearLayout
                    android:id="@+id/nav_placeholder"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md"
                    android:gravity="center">

                    <!-- 导航标题栏 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="@dimen/list_item_icon_size"
                            android:layout_height="@dimen/list_item_icon_size"
                            android:src="@drawable/ic_navigation"
                            android:tint="#00CED1" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/spacing_sm"
                            android:text="导航"
                            android:textColor="#FFFFFF"
                            android:textSize="@dimen/text_size_normal"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/nav_switch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="高德 ▼"
                            android:textColor="#00CED1"
                            android:textSize="@dimen/text_size_small" />

                    </LinearLayout>

                    <!-- 导航占位内容 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="@dimen/app_icon_size"
                            android:layout_height="@dimen/app_icon_size"
                            android:src="@drawable/ic_navigation"
                            android:tint="#4000CED1" />

                        <TextView
                            android:id="@+id/nav_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="点击启动导航"
                            android:textColor="#B0FFFFFF"
                            android:textSize="@dimen/text_size_medium" />

                    </LinearLayout>

                </LinearLayout>

                <!-- SDK导航控件容器（启动后显示） -->
                <FrameLayout
                    android:id="@+id/nav_sdk_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone">

                    <!-- 导航标题栏 -->
                    <LinearLayout
                        android:id="@+id/nav_sdk_toolbar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="#CC000000"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp">

                        <ImageView
                            android:layout_width="@dimen/icon_inner_size"
                            android:layout_height="@dimen/icon_inner_size"
                            android:src="@drawable/ic_navigation"
                            android:tint="#00CED1" />

                        <TextView
                            android:id="@+id/nav_sdk_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/spacing_sm"
                            android:text="高德地图"
                            android:textColor="#FFFFFF"
                            android:textSize="@dimen/text_size_small"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/nav_switch2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="切换"
                            android:textColor="#00CED1"
                            android:textSize="13sp"
                            android:padding="@dimen/spacing_xs"
                            android:background="?android:attr/selectableItemBackgroundBorderless" />

                        <ImageView
                            android:id="@+id/nav_close"
                            android:layout_width="@dimen/bottom_nav_icon_size"
                            android:layout_height="@dimen/bottom_nav_icon_size"
                            android:src="@drawable/ic_close"
                            android:padding="@dimen/spacing_xs"
                            android:background="?android:attr/selectableItemBackgroundBorderless" />

                    </LinearLayout>

                    <!-- 地图嵌入容器（系统级时动态创建 CarActivityView） -->
                    <FrameLayout
                        android:id="@+id/nav_activity_container"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="@dimen/title_bar_height" />

                    <!-- 加载中 -->
                    <LinearLayout
                        android:id="@+id/nav_loading"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="#E6101020"
                        android:visibility="gone">

                        <ProgressBar
                            android:layout_width="@dimen/list_item_icon_size"
                            android:layout_height="@dimen/list_item_icon_size"
                            android:indeterminateTint="#00CED1" />

                        <TextView
                            android:id="@+id/nav_loading_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="正在加载导航..."
                            android:textColor="#FFFFFF"
                            android:textSize="@dimen/text_size_small" />

                    </LinearLayout>

                </FrameLayout>

            </FrameLayout>

            <!-- 下半部分：音乐卡片 -->
            <LinearLayout
                android:id="@+id/music_card"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_plugin_card"
                android:clipToOutline="true"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="@dimen/spacing_sm">

                <!-- 左侧：音乐信息 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- 音乐标题栏 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="@dimen/icon_inner_size"
                            android:layout_height="@dimen/icon_inner_size"
                            android:src="@drawable/ic_music"
                            android:tint="#FF6B6B" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/spacing_sm"
                            android:text="音乐"
                            android:textColor="#FFFFFF"
                            android:textSize="@dimen/text_size_medium"
                            android:textStyle="bold" />

                        <!-- 音乐插件选择按钮 -->
                        <TextView
                            android:id="@+id/music_plugin_switch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="选择 ▼"
                            android:textColor="#FF6B6B"
                            android:textSize="@dimen/text_size_micro"
                            android:padding="@dimen/spacing_xs"
                            android:background="?android:attr/selectableItemBackgroundBorderless" />

                    </LinearLayout>

                    <!-- 音乐信息 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">

                        <ImageView
                            android:id="@+id/music_album"
                            android:layout_width="@dimen/list_item_icon_size"
                            android:layout_height="@dimen/list_item_icon_size"
                            android:src="@drawable/ic_music"
                            android:background="@drawable/bg_icon_cyan"
                            android:padding="@dimen/spacing_sm" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/spacing_sm"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/music_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="未在播放"
                                android:textColor="#FFFFFF"
                                android:textSize="@dimen/text_size_small"
                                android:textStyle="bold"
                                android:maxLines="1"
                                android:ellipsize="end" />

                            <TextView
                                android:id="@+id/music_artist"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text=""
                                android:textColor="#80FFFFFF"
                                android:textSize="12sp"
                                android:maxLines="1"
                                android:ellipsize="end" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

                <!-- 右侧：控制按钮 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/music_prev"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_skip_prev"
                        android:padding="8dp"
                        android:background="@drawable/bg_control_btn" />

                    <ImageView
                        android:id="@+id/music_play"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:src="@drawable/ic_play"
                        android:background="@drawable/bg_icon_cyan"
                        android:padding="12dp" />

                    <ImageView
                        android:id="@+id/music_next"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_skip_next"
                        android:padding="8dp"
                        android:background="@drawable/bg_control_btn" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- 底部导航栏 -->
        <include
            android:id="@+id/bottom_nav"
            layout="@layout/layout_bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="@dimen/bottom_nav_height" />

    </LinearLayout>

</FrameLayout>
