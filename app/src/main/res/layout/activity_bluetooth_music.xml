<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- 顶部标题栏 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/title_bar_height"
        android:paddingStart="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_md">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="@dimen/title_bar_back_size"
            android:layout_height="@dimen/title_bar_back_size"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_back"
            android:padding="@dimen/title_bar_back_padding"
            android:background="?android:attr/selectableItemBackgroundBorderless" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/btn_back"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/spacing_sm"
            android:text="蓝牙音乐"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_large"
            android:textStyle="bold" />

        <!-- 蓝牙状态 -->
        <ImageView
            android:id="@+id/iv_bluetooth_status"
            android:layout_width="@dimen/icon_inner_size"
            android:layout_height="@dimen/icon_inner_size"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_bluetooth_disabled" />

    </RelativeLayout>

    <!-- 蓝牙设备列表 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_bluetooth_devices"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_md"
        app:cardCornerRadius="@dimen/card_corner_radius"
        app:cardElevation="@dimen/card_elevation"
        app:cardBackgroundColor="@color/card_glass"
        xmlns:app="http://schemas.android.com/apk/res-auto">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="已配对设备"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_medium"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_bluetooth_devices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm" />

            <Button
                android:id="@+id/btn_scan_bluetooth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="扫描设备"
                android:textColor="@color/text_primary"
                android:background="@drawable/bg_button_secondary" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- 播放控制区 -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/spacing_md"
        android:layout_marginEnd="@dimen/spacing_md"
        android:layout_marginBottom="@dimen/spacing_md"
        app:cardCornerRadius="@dimen/card_corner_radius"
        app:cardElevation="@dimen/card_elevation"
        app:cardBackgroundColor="@color/card_glass"
        xmlns:app="http://schemas.android.com/apk/res-auto">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md"
            android:gravity="center">

            <!-- 歌曲信息 -->
            <TextView
                android:id="@+id/tv_song_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="未播放"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_large"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_song_artist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:text="未知歌手"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_small" />

            <!-- 歌词显示 -->
            <ScrollView
                android:id="@+id/scroll_lyrics"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="@dimen/spacing_md"
                android:fillViewport="true">

                <TextView
                    android:id="@+id/tv_lyrics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="暂无歌词"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_size_small"
                    android:lineSpacingMultiplier="1.5" />

            </ScrollView>

            <!-- 进度条 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_current_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_size_micro" />

                <SeekBar
                    android:id="@+id/seek_progress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:progressTint="@color/primary"
                    android:thumbTint="@color/primary" />

                <TextView
                    android:id="@+id/tv_total_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_size_micro" />

            </LinearLayout>

            <!-- 播放控制按钮 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:orientation="horizontal"
                android:gravity="center">

                <ImageView
                    android:id="@+id/btn_prev"
                    android:layout_width="@dimen/list_item_icon_size"
                    android:layout_height="@dimen/list_item_icon_size"
                    android:src="@drawable/ic_prev"
                    android:padding="@dimen/spacing_sm"
                    android:background="?android:attr/selectableItemBackgroundBorderless" />

                <ImageView
                    android:id="@+id/btn_play_pause"
                    android:layout_width="@dimen/app_icon_size"
                    android:layout_height="@dimen/app_icon_size"
                    android:layout_marginStart="@dimen/spacing_lg"
                    android:layout_marginEnd="@dimen/spacing_lg"
                    android:src="@drawable/ic_play"
                    android:padding="@dimen/spacing_sm"
                    android:background="@drawable/bg_play_button" />

                <ImageView
                    android:id="@+id/btn_next"
                    android:layout_width="@dimen/list_item_icon_size"
                    android:layout_height="@dimen/list_item_icon_size"
                    android:src="@drawable/ic_next"
                    android:padding="@dimen/spacing_sm"
                    android:background="?android:attr/selectableItemBackgroundBorderless" />

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>
